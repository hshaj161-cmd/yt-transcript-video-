# ============================================================
# YT Transcript Video - environment variables
# Copy to .env (local) or set in your host's dashboard (production).
# None of these are required for a basic local run.
# ============================================================

# --- Local development ---------------------------------------
# API backend port (server.js)
API_PORT=8000
# Frontend static server port (frontend.js)
FRONTEND_PORT=3000
# Where frontend.js proxies /api requests
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1

# --- Production (single-service host like Render) -------------
# The host injects PORT automatically; server.js and frontend.js
# both honor it. On Render, leave PORT unset here.
# PORT=10000

# Extra browser origins allowed to call the API cross-origin
# (comma-separated). localhost:3000 and the production domain are
# always allowed.
ALLOWED_ORIGINS=

# --- Behavior ------------------------------------------------
# All requests are anonymous; the app keeps no cookies or sessions.
# No API keys are needed - everything comes from YouTube's public data.
